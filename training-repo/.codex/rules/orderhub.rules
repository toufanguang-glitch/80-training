# Destructive operations are never permitted from an agent session.
prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "forbidden",
    justification = "Recursive forced deletion is prohibited.",
)
prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force-pushing can rewrite shared history.",
)
prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard reset can discard uncommitted work.",
)

# Operations with external or destructive effects require explicit approval.
prefix_rule(
    pattern = ["dotnet", "ef", "database", "drop"],
    decision = "prompt",
    justification = "Dropping a database requires user confirmation.",
)
prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Confirm before publishing changes to a remote.",
)

# Routine local development commands are safe to run without interruption.
prefix_rule(pattern = ["dotnet", "build"], decision = "allow", justification = "Routine build")
prefix_rule(pattern = ["dotnet", "test"], decision = "allow", justification = "Routine test run")
prefix_rule(pattern = ["dotnet", "run"], decision = "allow", justification = "Local application startup")
prefix_rule(pattern = ["git", "status"], decision = "allow", justification = "Read-only status check")
prefix_rule(pattern = ["git", "diff"], decision = "allow", justification = "Read-only diff")
prefix_rule(pattern = ["git", "log"], decision = "allow", justification = "Read-only history check")
prefix_rule(pattern = ["git", "add"], decision = "allow", justification = "Routine staging")
prefix_rule(pattern = ["git", "commit"], decision = "allow", justification = "Routine local commit")
